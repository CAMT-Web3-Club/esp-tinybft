CONFIG_EXAMPLE_ROLE_REPLICA=y
CONFIG_EXAMPLE_NODE_ID=0

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=32
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=true
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Flash size must match the ESP32-C3 hardware (4MB, not default 2MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# TinyBFT: use ESP-NOW transport
CONFIG_TBFT_TRANSPORT_ESPNOW=y

# TinyBFT tuning (match Kconfig defaults, reduce RAM for dev)
CONFIG_TBFT_RQUEUE_MAX=16
CONFIG_TBFT_NDET_BUF_SIZE=256
CONFIG_TBFT_MAX_STATE_BLOCKS=256
CONFIG_TBFT_P_LEVELS=4
CONFIG_TBFT_ANTI_REPLAY_WINDOW_MS=30000

# Custom partition table for SPIFFS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"