menu "Simple Wallet Example Configuration"

    choice EXAMPLE_NODE_ROLE
        prompt "Node role"
        default EXAMPLE_ROLE_REPLICA
        help
            Select whether this node runs as a BFT replica or a client.

        config EXAMPLE_ROLE_REPLICA
            bool "Replica"
        config EXAMPLE_ROLE_CLIENT
            bool "Client"
    endchoice

    config EXAMPLE_NODE_ID
        int "Node ID (replica only)"
        default 0
        range 0 31
        depends on EXAMPLE_ROLE_REPLICA
        help
            Which replica slot this node occupies (0..3f, where f is the
            fault tolerance set in the config file). Passed to
            Byz_init_replica as local_id AND selects the matching private
            key file (priv<N>.der generated by gen_configs.sh). Must be
            less than the num_replicas implied by the config file's f
            (=3f+1); Byz_init_replica validates this at runtime.

    config EXAMPLE_WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        depends on TBFT_TRANSPORT_UDP
        help
            SSID of the AP to connect to when using UDP transport.

    config EXAMPLE_WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        depends on TBFT_TRANSPORT_UDP
        help
            Password of the AP. Leave empty for open networks.

endmenu
