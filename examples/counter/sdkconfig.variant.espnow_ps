# ESP-NOW with duty-cycled receive (window/interval from main Kconfig).
# Senders must outlast a wake interval: 10 attempts x 20 ms (rounded to ticks).
CONFIG_TBFT_TRANSPORT_ESPNOW=y
CONFIG_EXAMPLE_ESPNOW_POWER_SAVE=y
CONFIG_EXAMPLE_ESPNOW_WAKE_WINDOW_MS=50
CONFIG_EXAMPLE_ESPNOW_WAKE_INTERVAL_MS=100
CONFIG_TBFT_ESPNOW_TX_RETRIES=12
CONFIG_TBFT_ESPNOW_TX_RETRY_DELAY_MS=20
