CONFIG_EXAMPLE_ROLE_REPLICA=y
CONFIG_EXAMPLE_WIFI_PS_NONE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=32
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Flash size must match the ESP32-C3 hardware (4MB, not default 2MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# TinyBFT: use ESP-NOW transport
CONFIG_TBFT_TRANSPORT_ESPNOW=y

# TinyBFT: 7 replicas + 1 client (f=2)
# MAX_NUM_REPLICAS=7 (1 less than total nodes; client is separate)
CONFIG_TBFT_MAX_NUM_REPLICAS=7

# TinyBFT: aggressive RAM reduction for ESP32-C3 (~80KB app heap)
# New_key needs 1840 bytes (1584 body + 256 RSA sig). Round to 2048.
CONFIG_TBFT_MAX_MESSAGE_SIZE=2048
CONFIG_TBFT_MAX_REPLY_SIZE=900

# Task WDT: 10s timeout
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_TBFT_RQUEUE_MAX=4
CONFIG_TBFT_NDET_BUF_SIZE=256
CONFIG_TBFT_MAX_STATE_BLOCKS=8
CONFIG_TBFT_P_LEVELS=2
CONFIG_TBFT_WINDOW_SIZE=4
CONFIG_TBFT_CHECKPOINT_INTERVAL=2
CONFIG_TBFT_ANTI_REPLAY_WINDOW_MS=30000

# Custom partition table for SPIFFS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Relax timeouts to accommodate slow RSA operations on ESP32-C3
CONFIG_TBFT_CLIENT_REPLY_TIMEOUT_MS=20000
CONFIG_TBFT_VIEW_CHANGE_TIMEOUT_US=15000000

# Enable IP fragmentation and reassembly for large UDP messages (e.g., New_key)
CONFIG_LWIP_IP4_FRAG=y
CONFIG_LWIP_IP4_REASSEMBLY=y

# Enable unicast UDP mode by default to prevent Wi-Fi router multicast packet drops
CONFIG_TBFT_DISABLE_MULTICAST=y


