menu "Counter Example Configuration"

    choice EXAMPLE_NODE_ROLE
        prompt "Node role"
        default EXAMPLE_ROLE_REPLICA
        help
            Select whether this node runs as a BFT replica or a client.

        config EXAMPLE_ROLE_REPLICA
            bool "Replica"
        config EXAMPLE_ROLE_CLIENT
            bool "Client"
    endchoice

    config EXAMPLE_CLIENT_REQUEST_INTERVAL_MS
        int "Client request interval (ms)"
        default 30000
        depends on EXAMPLE_ROLE_CLIENT
        help
            Delay between successive requests sent by the client to the
            replica cluster.

    config EXAMPLE_WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        depends on TBFT_TRANSPORT_UDP
        help
            SSID of the AP to connect to when using UDP transport.

    config EXAMPLE_WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        depends on TBFT_TRANSPORT_UDP
        help
            Password of the AP. Leave empty for open networks.

    choice EXAMPLE_WIFI_MODEM_PS
        prompt "WiFi Modem Power Save (STA mode)"
        default EXAMPLE_WIFI_PS_NONE
        depends on TBFT_TRANSPORT_UDP
        help
            Controls modem-sleep (power save) behaviour. The default here
            is Disabled (WIFI_PS_NONE): radio always on, lowest latency,
            highest power. MIN_MODEM wakes every DTIM; MAX_MODEM wakes every
            listen interval (see EXAMPLE_WIFI_LISTEN_INTERVAL) and may miss
            broadcast frames such as ARP requests.

        config EXAMPLE_WIFI_PS_NONE
            bool "Disabled (WIFI_PS_NONE)"
        config EXAMPLE_WIFI_PS_MIN_MODEM
            bool "Minimum (WIFI_PS_MIN_MODEM)"
        config EXAMPLE_WIFI_PS_MAX_MODEM
            bool "Maximum (WIFI_PS_MAX_MODEM)"
    endchoice

    config EXAMPLE_WIFI_LISTEN_INTERVAL
        int "Station listen interval (beacon intervals)"
        default 3
        range 1 10
        depends on TBFT_TRANSPORT_UDP
        help
            Only used with WIFI_PS_MAX_MODEM. Fixed explicitly so the
            experiment does not depend on the IDF default.

    config EXAMPLE_ESPNOW_CHANNEL
        int "ESP-NOW Wi-Fi channel"
        default 1
        range 1 13
        depends on TBFT_TRANSPORT_ESPNOW
        help
            Channel all boards use for ESP-NOW. Use the same channel as the
            router in the UDP runs so both transports share the RF environment.

endmenu
